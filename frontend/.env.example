# API base URL for the buyer backend.
#
# Vite inlines VITE_* variables at BUILD time, so changing this value requires a
# rebuild (and a redeploy on Vercel) — it cannot be switched at runtime.
#
# Local development against the bundled backend:
VITE_API_URL=http://localhost:8000

# VITE_API_BASE_URL is still read as a fallback for deployments configured with
# the older name. VITE_API_URL wins when both are set.
# VITE_API_BASE_URL=http://localhost:8000
