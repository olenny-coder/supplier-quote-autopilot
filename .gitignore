# --- secrets ------------------------------------------------------------------
# Never commit a real .env. Templates ARE committed:
#   .env.example      every setting, documented, PostgreSQL + real providers
#   backend/.env.dev  local defaults for `dev.cmd` (SQLite, console email, no key)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
public_form/.env
*.pem
*.key

# --- python -------------------------------------------------------------------
backend/.venv/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- node ---------------------------------------------------------------------
node_modules/
frontend/node_modules/
public_form/node_modules/
dist/
frontend/dist/
public_form/dist/
.vite/
coverage/
npm-debug.log*
yarn-error.log*

# --- local runtime state ------------------------------------------------------
# Uploaded files (dev storage backend) and scratch SQLite databases. The test
# suite and the Alembic walkthrough both create these.
backend/var/
var/
*.db
*.sqlite3
logs/
tmp/

# --- editors / os -------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- local launcher -----------------------------------------------------------
# dev.cmd IS committed: it is the documented way to run the stack locally, and it
# opens with "dev.cmd" from a Command Prompt. Ignore only personal overrides.
dev.local.cmd
