# Keeps the Docker build context small and prevents local secrets and build
# output from being baked into an image layer.

# --- secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- vcs / ci -----------------------------------------------------------------
.git
.gitignore
.gitattributes
.github

# --- python -------------------------------------------------------------------
**/__pycache__
**/*.py[cod]
**/.venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/htmlcov
**/.eggs
**/*.egg-info

# --- node ---------------------------------------------------------------------
**/node_modules
**/dist
**/.vite
**/coverage
**/npm-debug.log*

# --- local runtime state ------------------------------------------------------
**/var/uploads
**/*.db
**/*.sqlite3
logs
tmp
