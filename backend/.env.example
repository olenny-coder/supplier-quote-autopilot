# =============================================================================
# Backend environment — native local development
# =============================================================================
# Copy to `backend/.env`. Docker Compose uses the ROOT `.env` instead (same
# variables; see ../.env.example for the fully annotated list).
#
# Nothing here is required to boot except DATABASE_URL, which has a working local
# default. An empty LLM_API_KEY and EMAIL_PROVIDER=console give you a fully working
# app that uses deterministic AI fallbacks and logs email instead of sending it.
# =============================================================================

ENV=development

# ------------------------------------------------------------------ database
# Local Postgres. On Neon use the POOLED string here (hostname has `-pooler`)
# and the DIRECT string for DATABASE_URL_DIRECT (used only by Alembic).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/supplier_quote_db
DATABASE_URL_DIRECT=

# ---------------------------------------------------------------------- auth
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------- URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# The base URL of every supplier form link. Wrong value = every invitation 404s.
PUBLIC_FORM_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5174

# ----------------------------------------------------------------------- LLM
# Any OpenAI-compatible endpoint. Groq is the default; see the README section
# "Free LLM provider setup" for OpenRouter and Gemini. Leave LLM_API_KEY empty and
# quote parsing, follow-up drafting and the comparison narrative fall back to
# deterministic implementations — the app is fully functional without a key.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Free-tier guardrails. Groq allows ~30 requests/minute and 14,400/day per model.
LLM_ENABLED=true
LLM_REQUESTS_PER_MINUTE=30
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=60
# Reasoning models only (the default gpt-oss model is one). "low" keeps the
# reasoning trace short enough that the JSON answer still fits the token budget;
# at the provider default every JSON call was rejected with HTTP 400 and all three
# LLM features fell back to their deterministic paths. Set empty for a model whose
# endpoint rejects the field — the client already skips it for models it knows
# cannot take it.
LLM_REASONING_EFFORT=low
LLM_BATCH_MAX_CALLS=50

# --------------------------------------------------------------------- email
# HTTPS API only — SMTP is blocked on Render's free tier and is not implemented.
# `console` logs each message and sends nothing, which is what you want locally.
# console | resend | sendgrid | mailgun | brevo
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_API_URL=
MAIL_FROM=Supplier Quote Autopilot <onboarding@resend.dev>

# ------------------------------------------------------------------- storage
# `local` is fine locally. Production on Render MUST use `s3` — there is no
# persistent disk, so local uploads are lost on the next deploy.
STORAGE_BACKEND=local
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=10

# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=quotes
# S3_REGION=auto
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_BASE_URL=

# --------------------------------------------------------------- public form
INVITATION_TTL_DAYS=30
PUBLIC_RATE_LIMIT_PER_MINUTE=20
PUBLIC_RATE_LIMIT_PER_HOUR=60
# none | turnstile | hcaptcha
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------- follow-ups
# false = every reminder is a draft awaiting the buyer's approval.
# This does not affect awarding: an award always requires a human decision.
AUTO_SEND_FOLLOWUPS=false
FOLLOWUP_INTERVALS_HOURS=72,168
FOLLOWUP_BEFORE_DEADLINE_HOURS=48
MAX_FOLLOWUPS_PER_INVITATION=3
MAX_INCOMPLETE_REMINDERS=2

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15
# Required to enable POST /internal/scheduler/tick; the endpoint 403s while empty.
SCHEDULER_SECRET=

# ---------------------------------------------------------------------- demo
# Serves GET /demo/workspace: a sample tender anyone can read with no account.
# The payload is the committed snapshot at app/features/demo/workspace.json,
# regenerated with:  python -m scripts.seed_demo --dump-demo
# It is a file, not a query, so an anonymous visitor can never read real data.
# Nothing under /demo accepts a write. Set false to ship without a demo.
DEMO_MODE_ENABLED=true

# ------------------------------------------------------------ procurement type
# What a new RFQ is unless the buyer picks otherwise.
#   service  building maintenance and minor works — electrical, mechanical,
#            plumbing, painting, ACMV… Selects the service field contract, the
#            service scoring weights and the services vocabulary.
#   goods    supplies: MOQ, Incoterms, lead time, freight and duties.
DEFAULT_PROCUREMENT_TYPE=service

# ---------------------------------------------------------------- comparison
# Prices are normalized into this currency before anything is compared.
BASE_CURRENCY=SGD
# GST applied when a supplier states a rate but no explicit tax amount.
# 9.0 is the current Singapore rate; set 0 if you are not GST-registered.
DEFAULT_GST_RATE=9.0
# FX_RATES_JSON={"USD": 1.34, "MYR": 4.70}
# DEFAULT_SCORING_WEIGHTS_JSON={"price": 0.5, "response_time": 0.2, "risk": 0.3}
LEAD_TIME_RISK_DAYS=90
QUOTE_VALIDITY_WARNING_DAYS=7
