# =============================================================================
# Local development defaults for `dev.cmd` — copied to backend/.env on first run.
# =============================================================================
# This is deliberately NOT the same as .env.example. The example documents every
# setting and points at PostgreSQL, because that is what production uses. This one
# is tuned for "clone the repo, run one command, click a link":
#
#   * SQLite instead of Postgres  — no database server to install or start
#   * console email               — messages are printed, nothing is sent
#   * no LLM key                  — the deterministic fallbacks run instead
#   * auto-send off               — reminders queue for your approval
#
# Switch any of them by editing backend/.env after the first run; dev.cmd will
# leave your file alone once it exists.
# =============================================================================

ENV=development
APP_NAME=Supplier Quote Autopilot

# SQLite keeps the demo to one command. The file lives in backend/var/, which is
# git-ignored. Delete it (or run `dev.cmd reset`) to start over.
DATABASE_URL=sqlite:///./var/dev.db
DATABASE_URL_DIRECT=

# Fine for local use, and deliberately obviously-insecure so it never gets copied
# into a deployment. Generate a real one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-development-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
PUBLIC_FORM_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------- AI
# Leave the key empty and the app still works end to end: quote parsing,
# follow-up drafting, and the comparison narrative fall back to deterministic
# implementations. Add a free Groq key (https://console.groq.com) to see the
# AI-written reminders and summaries instead.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_ENABLED=true
LLM_REQUESTS_PER_MINUTE=30
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=4

# ------------------------------------------------------------------- email
# `console` prints each message to the API window and sends nothing, so no real
# supplier address is ever contacted from a dev machine.
EMAIL_PROVIDER=console
MAIL_FROM=Supplier Quote Autopilot <demo@example.com>

# ----------------------------------------------------------------- storage
STORAGE_BACKEND=local
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=10

# --------------------------------------------------------------- public form
# Relaxed here so you can click around without tripping the limiter. Production
# defaults are 20/minute and 60/hour.
PUBLIC_RATE_LIMIT_PER_MINUTE=60
PUBLIC_RATE_LIMIT_PER_HOUR=600
CAPTCHA_PROVIDER=none

# ---------------------------------------------------------------- follow-ups
# false = every reminder is a draft awaiting your approval. This does NOT affect
# awarding: an award always requires a human decision.
AUTO_SEND_FOLLOWUPS=false
FOLLOWUP_INTERVALS_HOURS=72,168
FOLLOWUP_BEFORE_DEADLINE_HOURS=48
MAX_FOLLOWUPS_PER_INVITATION=3
MAX_INCOMPLETE_REMINDERS=2

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15
# Lets you drive a sweep by hand:
#   curl -X POST http://localhost:8000/internal/scheduler/tick -H "X-Scheduler-Secret: demo-scheduler-secret"
SCHEDULER_SECRET=demo-scheduler-secret

# ---------------------------------------------------------------- comparison
BASE_CURRENCY=USD
LEAD_TIME_RISK_DAYS=90
QUOTE_VALIDITY_WARNING_DAYS=7
